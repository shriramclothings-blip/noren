{
  "buildCommand": "cd noren-messaging-frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "noren-messaging-frontend/dist",
  "installCommand": "echo skip",
  "framework": null,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://noren-iqk3.onrender.com/sitemap.xml"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
