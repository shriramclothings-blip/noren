PORT=5000
NODE_ENV=development
SITE_URL=https://www.norenfashion.in

# ── Database Configuration (Multi-Database Failover) ──────────────────────────
# Primary database (main source of data)
DATABASE_URL_1=your_neon_postgres_connection_string_1
# Backup database 2 (failover when DB1 quota exceeded)
DATABASE_URL_2=your_neon_postgres_connection_string_2
# Backup database 3 (failover when DB1 and DB2 quota exceeded)
DATABASE_URL_3=your_neon_postgres_connection_string_3
DATABASE_SSL=true

# ── Automatic Database Synchronization ────────────────────────────────────────
# Set to 'false' to disable automatic sync (default: enabled)
AUTO_SYNC_ENABLED=true

JWT_SECRET=your_jwt_secret_key
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
PAYTM_MID=your_paytm_merchant_id
PAYTM_MKEY=your_paytm_merchant_key
PAYTM_WEBSITE=YOUR_WEBSITE_NAME
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WEB
PAYTM_CALLBACK_URL=https://your-backend.example.com/api/orders/paytm/callback
PAYTM_FRONTEND_URL=http://localhost:5173
PAYTM_ENV=staging
ADMIN_SECRET_KEY=your_admin_secret_key
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=NOREN <noreply@yourdomain.com>
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:support@norenfashion.in
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_MODE=staging
DELHIVERY_PICKUP_NAME=Primary
DELHIVERY_RETURN_PINCODE=110001
DELHIVERY_RETURN_CITY=Delhi
DELHIVERY_RETURN_STATE=Delhi
DELHIVERY_RETURN_ADDRESS=Your return address
DELHIVERY_RETURN_PHONE=9999999999
DELHIVERY_GST=your_gst_number

# Monitor Dashboard Security — Required for DB switch/copy/shutdown operations
MONITOR_SECRET=your_secure_monitor_secret_key

# Comma-separated list of emails that are always granted super_admin role on Google login
SUPER_ADMIN_EMAILS=admin@yourdomain.com

# Render keep-alive: set this to your Render service's public URL (e.g. https://noren-iqk3.onrender.com)
# This enables the self-ping every 14 minutes to prevent free-tier cold starts.
RENDER_EXTERNAL_URL=https://your-render-service.onrender.com
