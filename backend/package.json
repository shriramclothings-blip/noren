{
  "name": "noren-fashion-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/runMigrations.js",
    "migrate:test": "node migrations/testMigrations.js",
    "db:sync": "node sync-databases.js",
    "db:monitor": "node database-monitor.js status",
    "db:watch": "node database-monitor.js watch",
    "db:sync-now": "node database-monitor.js sync",
    "db:setup": "node setup-database-sync.js",
    "admin:create": "node createAdmin.js",
    "admin:fix": "node fix-admin-login.js",
    "ai:test": "node -e \"console.log('🤖 AI Chatbot Monitor Ready!'); console.log('Access at: http://localhost:' + (process.env.PORT || 5000) + '/monitor'); console.log('Click AI Assistant tab to start chatting!')\"",
    "ai:health": "curl -s http://localhost:5000/api/chatbot-monitor/quick/health | node -e \"console.log(JSON.stringify(JSON.parse(require('fs').readFileSync(0, 'utf-8')), null, 2))\"",
    "ai:suggestions": "curl -s http://localhost:5000/api/chatbot-monitor/suggestions | node -e \"console.log(JSON.stringify(JSON.parse(require('fs').readFileSync(0, 'utf-8')), null, 2))\""
  },
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "paytmchecksum": "^1.0.6",
    "pg": "^8.20.0",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
